# ─────────────────────────────────────────────────────────────────────────────
# ATLAS — every variable below is OPTIONAL.
# Copy to `.env` only if you want to change a default:
#     cp .env.example .env
# With no .env at all, ATLAS runs on in-memory storage with a week of seeded
# demo incidents, live hotspots included.
# ─────────────────────────────────────────────────────────────────────────────

# Hotspot grid resolution in metres. ~40m is one building entrance or path
# segment — small enough to name the trouble spot, large enough to absorb GPS
# jitter.
ATLAS_HOTSPOT_CELL_M=40

# Incidents required inside one cell before it counts as a hotspot.
ATLAS_HOTSPOT_MIN_COUNT=2

# Default lookback window for /api/hotspots when the caller omits windowDays.
ATLAS_HOTSPOT_WINDOW_DAYS=7

# Retention cap — the oldest points are dropped past this, bounding storage.
ATLAS_MAX_POINTS=2000

# ─────────────────────────────────────────────────────────────────────────────
# Persistent storage (production only).
#
# Leave BOTH unset for local development — ATLAS then uses in-memory storage
# with best-effort persistence to ./.data, which needs no account and no setup.
#
# Set both to switch to Upstash Redis. Required when deploying to a serverless
# host such as Vercel, where memory does not survive between invocations.
# ─────────────────────────────────────────────────────────────────────────────
# UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-token
